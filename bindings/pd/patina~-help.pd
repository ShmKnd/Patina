#N canvas 160 80 1040 720 12;
#X text 30 24 patina~;
#X text 30 50 Patina analog-modeling DSP external for Pure Data and PlugData;
#X text 30 86 Use [patina~ <engine>] or [patina-<engine>~]. Alias objects have engine-specific option-click help.;
#X text 30 116 Example below uses [patina-drive~]. Turn DSP on to listen.;
#X obj 45 155 osc~ 110;
#X obj 45 190 *~ 0.18;
#X obj 45 405 patina-drive~;
#X obj 45 470 dac~;
#X obj 215 155 loadbang;
#X msg 215 190 param drive 0.72;
#X text 430 190 drive;
#X msg 215 225 param tone 0.55;
#X text 430 225 tone;
#X msg 215 260 param output 0.72;
#X text 430 260 output;
#X msg 215 295 param mix 1;
#X text 430 295 mix;
#X msg 215 340 reset;
#X text 430 340 clear state;
#X text 610 112 open per-engine help;
#X msg 610 145 \; pd open patina-drive~-help.pd .;
#X text 860 145 [patina-drive~];
#X msg 610 185 \; pd open patina-filter~-help.pd .;
#X text 860 185 [patina-filter~];
#X msg 610 225 \; pd open patina-delay~-help.pd .;
#X text 860 225 [patina-delay~];
#X msg 610 265 \; pd open patina-reverb~-help.pd .;
#X text 860 265 [patina-reverb~];
#X msg 610 305 \; pd open patina-compressor~-help.pd .;
#X text 860 305 [patina-compressor~];
#X msg 610 345 \; pd open patina-modulation~-help.pd .;
#X text 860 345 [patina-modulation~];
#X msg 610 385 \; pd open patina-tape~-help.pd .;
#X text 860 385 [patina-tape~];
#X msg 610 425 \; pd open patina-eq~-help.pd .;
#X text 860 425 [patina-eq~];
#X msg 610 465 \; pd open patina-limiter~-help.pd .;
#X text 860 465 [patina-limiter~];
#X msg 610 505 \; pd open patina-channelstrip~-help.pd .;
#X text 860 505 [patina-channelstrip~];
#X msg 610 545 \; pd open patina-envelope~-help.pd .;
#X text 860 545 [patina-envelope~];
#X text 30 540 Generic objects still work: [patina~ drive], [patina~ filter], [patina~ delay], etc.;
#X text 30 570 Pd help lookup ignores object arguments, so [patina~ filter] opens this common help. Use [patina-filter~] for direct filter help.;
