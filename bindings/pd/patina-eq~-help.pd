#N canvas 120 60 1040 650 12;
#X text 35 24 patina-eq~;
#X text 35 50 Three-band EQ engine;
#X text 35 78 gain values are dB-like controls;
#X text 35 102 enable_* values are 0/1;
#X obj 45 163 noise~;
#X obj 45 198 *~ 0.1;
#X obj 45 684 patina-eq~;
#X obj 45 739 dac~;
#X msg 245 163 param low 1;
#X text 520 163 0/1 enable low;
#X msg 245 189 param low_freq 200;
#X text 520 189 Hz;
#X msg 245 215 param low_gain 4;
#X text 520 215 dB;
#X msg 245 241 param low_resonance 0.3;
#X text 520 241 0..1;
#X msg 245 267 param mid 1;
#X text 520 267 0/1 enable mid;
#X msg 245 293 param mid_freq 1000;
#X text 520 293 Hz;
#X msg 245 319 param mid_gain -3;
#X text 520 319 dB;
#X msg 245 345 param mid_q 0.5;
#X text 520 345 0.1..1;
#X msg 245 371 param high 1;
#X text 520 371 0/1 enable high;
#X msg 245 397 param high_freq 4000;
#X text 520 397 Hz;
#X msg 245 423 param high_gain 2;
#X text 520 423 dB;
#X msg 245 449 param high_resonance 0.3;
#X text 520 449 0..1;
#X msg 245 475 param temperature 25;
#X text 520 475 degrees C;
#X msg 245 501 param output 0;
#X text 520 501 output dB;
#X msg 245 527 param supply 9;
#X text 520 527 supply voltage;
#X msg 245 553 param pedal_mode 0;
#X text 520 553 0 outboard, 1 pedal;
#X msg 245 594 reset;
#X text 520 594 clear internal state;
#X text 35 640 All messages are clickable. Values are starting points, not limits unless noted.;
